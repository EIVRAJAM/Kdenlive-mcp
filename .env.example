# Restrict future MCP file operations to explicit allowlists.
# Colon-separated paths are accepted by the initial config loader.
KDENLIVE_MCP_ALLOWED_MEDIA_DIRS=/home/abrahamc/Videos
KDENLIVE_MCP_ALLOWED_PROJECT_DIRS=/home/abrahamc/Videos:/data/PROYECTOS/kdenlive-mcp/examples
KDENLIVE_MCP_ALLOWED_OUTPUT_DIRS=/home/abrahamc/Videos:/data/PROYECTOS/kdenlive-mcp/examples

# Flatpak application id used for Kdenlive tooling.
KDENLIVE_MCP_FLATPAK_ID=org.kde.kdenlive
